{
  "name": "ptt-danmaku",
  "version": "0.1.0",
  "description": "PTT 推文彈幕 overlay — 邊看網球直播邊看鄉民推文",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "tw.local.ptt-danmaku",
    "productName": "PTT彈幕",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "runtime.js",
      "control.html",
      "overlay.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/ptt-backend.exe",
        "to": "backend/ptt-backend.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PTT彈幕-Windows-${version}-${arch}.${ext}"
    }
  }
}
