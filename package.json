{
  "name": "ptt-danmaku",
  "version": "1.0.0",
  "description": "PTT 推文彈幕 overlay — 邊看直播邊看鄉民推文,不需要登入",
  "author": "jeje898281",
  "license": "MIT",
  "homepage": "https://github.com/jeje898281/ptt-danmaku#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeje898281/ptt-danmaku.git"
  },
  "bugs": {
    "url": "https://github.com/jeje898281/ptt-danmaku/issues"
  },
  "keywords": ["ptt", "danmaku", "overlay", "electron", "彈幕"],
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "live-check": "node scripts/live-check.js",
    "icons": "electron scripts/make-icons.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "tw.local.ptt-danmaku",
    "productName": "PTT彈幕",
    "artifactName": "PTT-Danmaku-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PTT-Danmaku-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "PTT-Danmaku-${version}-win-${arch}-portable.${ext}"
    }
  }
}
